# Opsional — nilai default sudah disediakan di docker-compose.yml
# Salin ke .env hanya bila perlu meng-override.

# --- Keamanan (wajib di produksi — fail-fast di app/core/config.py) ---
# ENVIRONMENT=production MEMBLOKIR start bila JWT_SECRET lemah/dev atau
# COOKIE_SECURE=false. Jangan pernah jalankan produksi tanpa ini.
# ENVIRONMENT=production
# JWT secret acak minimal 32 byte. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=
# Cookie sesi hanya dikirim via HTTPS — WAJIB true di produksi.
# COOKIE_SECURE=true

# Origin web yang sah (list JSON) + URL untuk redirect Google OAuth.
# Ganti ke domain produksi, bukan localhost.
# CORS_ORIGINS=["https://jernihai.example.com"]
# WEB_URL=https://jernihai.example.com

# URL API yang DILIHAT BROWSER (dipakai web memanggil API) — produksi wajib
# domain publik, bukan localhost. Contoh: https://jernihai.example.com
# NEXT_PUBLIC_API_URL=

# --- Google OAuth (FR-01 — opsional, kosong = tombol Google nonaktif) ---
# Panduan lengkap: docs/GUIDE_GOOGLE_OAUTH.md (Google Cloud Console →
# OAuth client ID → Authorized redirect URI = <WEB_URL>/api/v1/auth/google/callback)
# GOOGLE_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx

# --- Cloudflare R2 (Fase 3 — storage produksi & multi-node) ---
# Panduan lengkap: docs/GUIDE_R2.md. Default local = disk (dev).
# STORAGE_BACKEND=local        # "local" | "r2"
# Account ID Cloudflare (32 karakter): dashboard → kanan atas.
# R2_ACCOUNT_ID=
# R2 API Token → Access Key ID + Secret Access Key (RAHASIA, sekali tampil).
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# Nama bucket (buat manual di dashboard R2).
# R2_BUCKET=jernihai

# --- Rate limiting (NFR-04) ---
# "memory" (default) = counter per proses — cukup single-instance & dev.
# "redis" = state dibagi antar instance — WAJIB untuk produksi multi-node.
# RATE_LIMIT_BACKEND=memory

POSTGRES_USER=jernihai
POSTGRES_PASSWORD=jernihai
POSTGRES_DB=jernihai
# Port host PostgreSQL — override bila 5432 terpakai (mis. POSTGRES_PORT=5434)
POSTGRES_PORT=5432

# --- Enhance pipeline (Fase 2 — ADR-002) ---
# Backend inference: "auto" (real bila model tersedia, fallback mock),
# "real" (wajib model — untuk worker GPU), "mock" (dev laptop).
# ENHANCE_BACKEND=auto
# Direktori weights (di luar repo, lihat scripts/download_models.py).
# MODEL_DIR=storage/models
# "auto" = cuda bila tersedia, selain itu cpu.
# MODEL_DEVICE=auto
# Tiling mencegah OOM di GPU (prd.md §10: tile 400-512, tile_pad 10-32).
# TILE_SIZE=512
# TILE_PAD=10
# FP16 aktif hanya di CUDA.
# HALF_PRECISION=true

# --- Vast.ai (pemantau biaya: infra/vast/vast_cost_monitor.py) ---
# API key Vast.ai — RAHASIA. JANGAN commit. Isi di file .env (sudah di-gitignore),
# bukan di sini. Skrip auto-load .env dari root repo.
# Ambil key: console.vast.ai/manage-keys → API Keys → + New (hanya tampil sekali).
# VAST_API_KEY=
# Alert bila kredit total (credit+balance) Vast.ai < $N — 0 = mati (default 2.0).
# VAST_MONITOR_MIN_CREDIT=2.0

# --- Pembayaran (FR-11 — Midtrans Snap) ---
# Isi di file .env (sudah di-gitignore). Ambil di dashboard.sandbox.midtrans.com
# → Settings → Access Keys. Sandbox default; set true hanya di produksi.
# Server key kosong = checkout mode MOCK (dev tanpa SDK).
# MIDTRANS_SERVER_KEY=
# MIDTRANS_CLIENT_KEY=
# MIDTRANS_IS_PRODUCTION=false
# Dipakai web (NEXT_PUBLIC_MIDTRANS_PRODUCTION) untuk memilih URL script Snap.
# NEXT_PUBLIC_MIDTRANS_PRODUCTION=false

# --- Admin (FR-13) ---
# Email yang berhak akses halaman/endpoint admin (list JSON).
# ADMIN_EMAILS=["admin@example.com"]
