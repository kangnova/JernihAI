# Salin ke .env lalu sesuaikan bila perlu (dev lokal tanpa Docker).
APP_NAME=JernihAI API
APP_VERSION=0.1.0
ENVIRONMENT=development

# List JSON (string) — parse otomatis oleh pydantic-settings.
CORS_ORIGINS=["http://localhost:3000"]

# Dev lokal; saat memakai docker compose, nilai ini di-override service.
DATABASE_URL=postgresql+asyncpg://jernihai:jernihai@localhost:5432/jernihai
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Auth (WAJIB ganti di produksi) ---
JWT_SECRET=dev-secret-ganti-di-produksi-0123456789abcdef
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
COOKIE_NAME=jernihai_session
COOKIE_SECURE=false

# --- Google OAuth (isi bila ingin login pakai Google) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WEB_URL=http://localhost:3000

# --- Upload & storage (Fase 1) ---
UPLOAD_DIR=storage/uploads
RESULT_DIR=storage/results
MAX_UPLOAD_BYTES=10485760
# true = proses job inline tanpa Redis (hanya untuk dev/test)
CELERY_TASK_ALWAYS_EAGER=false

# --- Kuota gratis (FR-06) ---
# Jumlah gambar gratis per user per hari (reset otomatis 00:00 WIB).
# FREE_DAILY_QUOTA=3

# --- Rate limit (NFR-04) ---
# Ambang per menit per IP (fixed-window in-memory).
# RATE_LIMIT_AUTH_PER_MINUTE=10
# RATE_LIMIT_UPLOAD_PER_MINUTE=30

# --- API Publik B2B (FR-14) ---
# Rate limit API publik per menit per API key, berdasarkan tier key.
# API_RATE_LIMIT_FREE_PER_MINUTE=20
# API_RATE_LIMIT_PRO_PER_MINUTE=120

# --- Pembayaran (FR-11 — Midtrans Snap) ---
# Ambil key di dashboard.sandbox.midtrans.com → Settings → Access Keys.
# Sandbox default; set true saat memakai akun produksi.
# Server key KOSONG => checkout memakai token MOCK (dev tanpa SDK/key),
# webhook tetap diverifikasi (key kosong => 403).
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# MIDTRANS_IS_PRODUCTION=false
